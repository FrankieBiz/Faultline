#!/usr/bin/env bash
set -euo pipefail
# BSD readlink has no -f. Follow each link relative to its own directory.
# Resolve in subshells so the CLI still receives the caller's working directory.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIRECTORY="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  case "$SOURCE" in
    /*) ;;
    *) SOURCE="$DIRECTORY/$SOURCE" ;;
  esac
done
ROOT="$(cd -P "$(dirname "$SOURCE")" && pwd)"
if ! command -v uv >/dev/null 2>&1; then
  for DIRECTORY in "$HOME/.local/bin" "$HOME/.cargo/bin" /opt/homebrew/bin /usr/local/bin; do
    if [ -x "$DIRECTORY/uv" ]; then
      export PATH="$DIRECTORY:$PATH"
      break
    fi
  done
fi
command -v uv >/dev/null 2>&1 || {
  echo "uv is required. Run make setup in $ROOT (or ./scripts/setup.sh) first." >&2
  exit 1
}
# The editable install's .pth file can carry macOS's hidden flag, which makes
# Python skip it. Use only this installation's source paths for the launcher.
export PYTHONPATH="$ROOT/services/repair-orchestrator:$ROOT"
exec uv run --project "$ROOT/services/repair-orchestrator" --python 3.13 --locked --no-env-file python -m app.cli "$@"
