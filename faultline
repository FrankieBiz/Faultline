#!/usr/bin/env bash
set -euo pipefail
# Resolve the installation, including a symlink placed on PATH; retain the caller's cwd.
SOURCE="$(readlink -f -- "${BASH_SOURCE[0]}")"
ROOT="$(cd -- "$(dirname -- "$SOURCE")" && pwd)"
exec uv run --project "$ROOT/services/repair-orchestrator" --python 3.13 --locked --no-env-file python -m app.cli "$@"
