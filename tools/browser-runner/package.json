{
  "name": "faultline-browser-runner",
  "version": "1.0.0",
  "private": true,
  "description": "Trusted Playwright CLI and oracle for the FaultLine checkout-flow scenario.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "faultline-browser-runner": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/oracle.d.ts",
      "default": "./dist/oracle.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "playwright test --project=unit",
    "test:e2e": "playwright test --project=chromium-e2e",
    "check": "npm run typecheck && npm run build && npm run test:unit",
    "checkout": "node dist/cli.js",
    "test:storefront": "FAULTLINE_STOREFRONT_TEST=1 playwright test --project=storefront",
    "test:inspector": "FAULTLINE_INSPECTOR_TEST=1 playwright test --project=inspector"
  },
  "dependencies": {
    "@playwright/test": "1.64.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  }
}
